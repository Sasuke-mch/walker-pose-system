# Runtime outputs
outputs/
realtime_app/outputs/
runs/
logs/
*.log
*.jsonl
raw_predictions.json
*_predictions.json

# Derived benchmark assets and model exchanges.  Keep their small manifests in
# the research registry instead of committing duplicated frames/predictions.
benchmarks/inputs/
benchmarks/exchange/
benchmarks/preflight/

# Local research archive.  Raw captures, rendered videos, JSONL outputs, code
# snapshots, audits, and retired/debug material remain local.  Git tracks only
# the archive guide, templates, and compact registry metadata.
research_records/*
!research_records/README.md
!research_records/registry/
!research_records/registry/**
!research_records/templates/
!research_records/templates/**

# Historical patches and calibration source sessions; the maintained source is
# in realtime_app/pose_app and calibration/results/stereo_fisheye.json.
migration_backups/
realtime_app/_virtual_camera_patch/
realtime_app/backups/
realtime_app/raw_pair_recording_patch_20260823/
realtime_app/undistort_model_input_patch_20260823/
realtime_app/calibration/iterations/
realtime_app/calibration/results/*_before_*.json

# Local handoff notes, not project documentation.
to_gpt/

# Calibration raw data (only keep results/*.json)
realtime_app/calibration/captures/
realtime_app/calibration/reports/

# Temporary and backup
*.bak
*.bak_*
*.tmp
*_backup_*/
diagnostics/static_check_summary.json
_environment_checks/
_pmpose_smoke_test/

# 资料 (non-code assets)
资料/

# Large files
*.zip
*.tar
*.tar.gz
*.avi
*.mp4
*.mov

# Allow selected public examples
!benchmarks/qualitative/*.jpg
!benchmarks/qualitative/*.png
!examples/demo_short.mp4

# Datasets
datasets/
data/
weights/
external_models/
model_cache/
