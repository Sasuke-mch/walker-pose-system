diff --git a/libs/pnp/test/multicam_contract_test.cpp b/libs/pnp/test/multicam_contract_test.cpp
new file mode 100644
index 0000000..aa76dc4
--- /dev/null
+++ b/libs/pnp/test/multicam_contract_test.cpp
@@ -0,0 +1,60 @@
+#include "common/include_gtest.h"
+#include "camera/camera.h"
+#include "camera/observation.h"
+#include "camera/rig.h"
+#include "pnp/multicam_pnp.h"
+
+namespace test::pnp {
+using namespace cuvslam;
+
+class PnpGeometryContract : public ::testing::Test {
+protected:
+  camera::PinholeCameraModel camera{Vector2T(640, 480), Vector2T(320, 320), Vector2T(320, 240)};
+  camera::Rig rig;
+  std::unordered_map<TrackId, Vector3T> landmarks;
+  std::vector<camera::Observation> observations;
+  cuvslam::pnp::PNPSettings settings;
+  Isometry3T pose = Isometry3T::Identity();
+  Matrix6T information;
+
+  void SetUp() override {
+    rig.num_cameras = 1;
+    rig.camera_from_rig[0] = Isometry3T::Identity();
+    rig.intrinsics[0] = &camera;
+    settings.filter_new_observations = false;
+    for (int i = 0; i < 20; ++i) {
+      Vector3T point(-.7f + .17f * (i % 5), -.6f + .19f * (i / 5), 2.f + .13f * (i % 3));
+      landmarks[i] = point;
+      observations.push_back({CameraId(0), TrackId(i), point.head<2>() / point.z(), Matrix2T::Identity()});
+    }
+  }
+
+  bool Solve() { return cuvslam::pnp::PNPSolver(rig).solve(pose, information, observations, landmarks, settings); }
+};
+
+TEST_F(PnpGeometryContract, RejectsZeroAssociated3DDespiteEnoughRawTracks) {
+  landmarks.clear();
+  EXPECT_FALSE(Solve());
+}
+TEST_F(PnpGeometryContract, RejectsOneAssociated3DDespiteEnoughRawTracks) {
+  auto point = landmarks.at(0);
+  landmarks.clear();
+  landmarks[0] = point;
+  EXPECT_FALSE(Solve());
+}
+TEST_F(PnpGeometryContract, RejectsRankDeficientLowCostBeforeIdentityInformationExit) {
+  for (auto& [id, point] : landmarks) {
+    point = Vector3T(0, 0, 2.f + .1f * id);
+  }
+  for (auto& observation : observations) observation.xy.setZero();
+  EXPECT_FALSE(Solve());
+}
+TEST_F(PnpGeometryContract, RejectsAllAssociatedPointsBehindCamera) {
+  for (auto& [id, point] : landmarks) point.z() = -point.z();
+  EXPECT_FALSE(Solve());
+}
+TEST_F(PnpGeometryContract, AcceptsNondegenerateExactObservedPose) {
+  EXPECT_TRUE(Solve());
+  EXPECT_LT((pose.matrix() - Isometry3T::Identity().matrix()).norm(), 1e-6f);
+}
+}  // namespace test::pnp
