diff --git a/src/Frame.cc b/src/Frame.cc
--- a/src/Frame.cc
+++ b/src/Frame.cc
@@ -1113 +1113,7 @@ Frame::Frame(const cv::Mat &imLeft, const cv::Mat &imRight, const double &timeStamp,
-    cv::vconcat(mDescriptors,mDescriptorsRight,mDescriptors);
+    // Exclusion masks can leave either camera without static features.
+    if(mDescriptors.empty())
+        mDescriptors = mDescriptorsRight.clone();
+    else if(!mDescriptorsRight.empty())
+        cv::vconcat(mDescriptors,mDescriptorsRight,mDescriptors);
+    // With an empty right side the left descriptors are already complete.
+
@@ -1131,3 +1137,0 @@ void Frame::ComputeStereoFishEyeMatches() {
-    cv::Mat stereoDescLeft = mDescriptors.rowRange(monoLeft, mDescriptors.rows);
-    cv::Mat stereoDescRight = mDescriptorsRight.rowRange(monoRight, mDescriptorsRight.rows);
-
@@ -1139,0 +1143,8 @@ void Frame::ComputeStereoFishEyeMatches() {
+    // Preserve unavailable stereo support instead of slicing an empty Mat.
+    // This is the masked frame51 failure; no matching threshold is changed.
+    if(stereoLeft.empty() || stereoRight.empty())
+        return;
+
+    cv::Mat stereoDescLeft = mDescriptors.rowRange(monoLeft, mDescriptors.rows);
+    cv::Mat stereoDescRight = mDescriptorsRight.rowRange(monoRight, mDescriptorsRight.rows);
+
