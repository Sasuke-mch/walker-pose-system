@@ -793,0 +794,18 @@
+            cv::Mat levelExclusion;
+            if(!mExclusionMask.empty())
+            {
+                CV_Assert(mExclusionMask.type() == CV_8UC1);
+                cv::Mat floatMask, resizedMask;
+                cv::compare(mExclusionMask, 0, floatMask, cv::CMP_GT);
+                floatMask.convertTo(floatMask, CV_32F);
+                // Area aggregation retains thin excluded structures at coarse
+                // pyramid levels; nearest-neighbor could silently erase them.
+                cv::resize(floatMask, resizedMask, mvImagePyramid[level].size(), 0, 0, cv::INTER_AREA);
+                cv::compare(resizedMask, 0, levelExclusion, cv::CMP_GT);
+                // Rotated descriptor pattern reaches ~19 pixels, plus the
+                // Gaussian descriptor prefilter. A 22-pixel halo prevents
+                // dynamic pixels from entering retained descriptors.
+                cv::dilate(levelExclusion, levelExclusion,
+                    cv::getStructuringElement(cv::MORPH_RECT, cv::Size(45,45)));
+            }
+
